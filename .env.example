# Tdqeq Environment Configuration Template
# Copy this file to '.env' and modify as needed.

# HuggingFace YOLO Weights Path
# If left blank or commented out, the pipeline will auto-download the weights.
# TDQEQ_YOLO_WEIGHTS_PATH=/path/to/your/local/doclayout_yolo_docstructbench_imgsz1280_2501.pt

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
TDQEQ_LOG_LEVEL=INFO

# PDF rendering DPI (higher means better accuracy but slower processing)
TDQEQ_DEFAULT_DPI=120

# Default batch size for GPU/CPU inference
TDQEQ_DEFAULT_BATCH_SIZE=4

# OpenAI API Configuration (Required only for the LLM Normalization layer)
# TDQEQ_OPENAI_API_KEY=your-openai-api-key-here
# TDQEQ_OPENAI_MODEL=gpt-4.1-mini
# TDQEQ_OPENAI_BASE_URL=https://api.openai.com/v1

